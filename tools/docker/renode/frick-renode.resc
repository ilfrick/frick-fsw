# frick-fsw - Renode functional validation script (PolarFire SoC).
#
# Loads the Microchip PolarFire SoC board (BeagleV-Fire, which includes the SoC
# and adds the QSPI NOR flash + system services), runs the middleware under test
# (the RTEMS image built with FF_ENABLE_RENODE_TEST=ON) and captures the console
# for the "RENODE_TEST: PASS" marker. See docs/vv/renode-environment.md, norm N18.
#
# Copyright (C) 2026 Ilfrick
# https://github.com/ilfrick/frick-fsw | https://www.housefz.com/git/ilfrick/frick-fsw
# SPDX-License-Identifier: MPL-2.0

$program ?= @/workspace/build/renode/frick_fsw_renode.elf

mach create "frick-renode"
machine LoadPlatformDescription @platforms/boards/beaglev-fire.repl
# The RTEMS mpfs64imafdc console is mmuart1 (0x20100000); capture it to a file.
sysbus.mmuart1 CreateFileBackend @/tmp/frick-uart.log
sysbus LoadELF $program
# Run only the U54 boot hart (hart 1) at the RTEMS image entry (0x1000000000,
# the PolarFire SoC/HSS high DDR alias); halt the E51 monitor and the other U54s.
e51 IsHalted true
u54_2 IsHalted true
u54_3 IsHalted true
u54_4 IsHalted true
u54_1 PC 0x1000000000
start
sleep 8
quit
