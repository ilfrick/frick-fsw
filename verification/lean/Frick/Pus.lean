-- frick-fsw - PUS core dispatch formal model
--
-- Mirrors the dispatch rules of src/pus/pus.c and src/pus/pus_services.c:
--   * service 1 verification is emitted for every acknowledged stage;
--   * a TC acknowledged for acceptance and completion produces at least two
--     verification telemetry packets;
--   * the TM message type counter strictly increases between two successive
--     telemetry packets (mod 16384, 14 bit field);
--   * unknown service/subservice results in a completion failure (not an
--     accepted execution).
--
-- Copyright (C) 2026 Ilfrick
-- https://github.com/ilfrick/frick-fsw | https://www.housefz.com/git/ilfrick/frick-fsw
-- SPDX-License-Identifier: MPL-2.0
import Frick.Common

namespace Frick.Pus

open Frick.Common

structure AckFlags where
  acceptance : Bool
  start : Bool
  progress : Bool
  completion : Bool
deriving Repr

structure TcHdr where
  service : Nat
  subservice : Nat
  ack : AckFlags
deriving Repr

-- | Number of verification telemetry packets generated by one TC, given the
--   acknowledgement flags and execution success.
def verificationCount (a : AckFlags) : Nat :=
  (if a.acceptance then 1 else 0) +
  (if a.start then 1 else 0) +
  (if a.completion then 1 else 0)

-- | A TC with both acceptance and completion acknowledgement enabled always
--   produces at least two verification packets (SRS-REQ-006).
theorem complete_ack_produces_two {a : AckFlags}
    (hacc : a.acceptance = true) (hcomp : a.completion = true) :
    verificationCount a ≥ 2 := by
  have ha : (if a.acceptance = true then 1 else 0) = 1 := by rw [hacc]; simp
  have hc : (if a.completion = true then 1 else 0) = 1 := by rw [hcomp]; simp
  have hs : 0 ≤ (if a.start = true then 1 else 0) := by split <;> omega
  unfold verificationCount
  omega

-- | Every acknowledged stage maps to exactly one verification packet.
theorem ack_acceptance_is_counted {a : AckFlags} (h : a.acceptance = true) :
    verificationCount a ≥ 1 := by
  have ha : (if a.acceptance = true then 1 else 0) = 1 := by rw [h]; simp
  have hs : 0 ≤ (if a.start = true then 1 else 0) := by split <;> omega
  have hc : 0 ≤ (if a.completion = true then 1 else 0) := by split <;> omega
  unfold verificationCount
  omega

-- ---------------------------------------------------------------------
-- TM message type counter (14 bit field), SRS-REQ-007
--
-- The model below is the arithmetic the flight code actually executes, not an
-- abstract monotone sequence. `src/pus/pus.c` advances the shared counter with
--
--     next = (uint16_t)((cur + 1u) & 0x3FFFu)        -- i.e. (cur + 1) mod 16384
--
-- on both the normal and the reset/panic emission path, and puts `cur` in the
-- frame. An earlier model used two unrelated `Nat` functions (`nextTm c = c + 1`
-- and a separate `wrapTm c = c % 16384`), so the proved properties did not
-- constrain the shipped modulo arithmetic at all (R3 finding F-3, 2026-11-17).
-- ---------------------------------------------------------------------

/-- The counter domain: the 14 bit field, `0 .. 16383`. -/
abbrev TmCounter := Nat

/-- One advance of the shipped sequence: `(c + 1) mod 16384`, matching
    `(uint16_t)((cur + 1u) & 0x3FFFu)` in `src/pus/pus.c`. -/
def tmStep (c : Nat) : Nat := (c + 1) % 16384

/-- Every advance stays inside the 14 bit field. -/
theorem tm_step_bounded (c : Nat) : tmStep c < 16384 := by
  unfold tmStep
  exact Nat.mod_lt _ (by decide)

/-- Below the wrap point the advance is exactly one. -/
theorem tm_step_succ (c : Nat) (h : c < 16383) : tmStep c = c + 1 := by
  unfold tmStep
  exact Nat.mod_eq_of_lt (by omega)

/-- Strict increase on the non-wrapping part of the sequence. -/
theorem tm_counter_strictly_increases (c : Nat) (h : c < 16383) : tmStep c > c := by
  have := tm_step_succ c h
  omega

/-- The last value of the field advances to zero: the sequence wraps. -/
theorem tm_counter_wraps_to_zero : tmStep 16383 = 0 := by
  unfold tmStep
  decide

/-- The advance is injective on the field: two distinct in-range values never
    advance to the same value, so two transmitted frames can never share a
    counter value. -/
theorem tm_step_injective (a b : Nat) (ha : a < 16384) (hb : b < 16384)
    (h : tmStep a = tmStep b) : a = b := by
  unfold tmStep at h
  have key : ∀ x y : Nat, x < 16384 → y < 16384 → (x + 1) % 16384 = (y + 1) % 16384 → x = y := by
    intro x y hx hy hxy
    have hx' : x + 1 ≤ 16384 := by omega
    have hy' : y + 1 ≤ 16384 := by omega
    rcases Nat.lt_or_eq_of_le hx' with hlt | heq
    · rw [Nat.mod_eq_of_lt hlt] at hxy
      rcases Nat.lt_or_eq_of_le hy' with hlt2 | heq2
      · rw [Nat.mod_eq_of_lt hlt2] at hxy
        omega
      · rw [heq2, Nat.mod_self] at hxy
        omega
    · rw [heq, Nat.mod_self] at hxy
      rcases Nat.lt_or_eq_of_le hy' with hlt2 | _heq2
      · rw [Nat.mod_eq_of_lt hlt2] at hxy
        omega
      · omega
  exact key a b ha hb h

end Frick.Pus
